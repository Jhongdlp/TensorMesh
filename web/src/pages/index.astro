---
import LandingPage from "../components/LandingPage.tsx";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Atlas Vectorial</title>
    <meta
      name="description"
      content="Galaxia navegable de embeddings: 50.000 palabras por idioma, colocadas por simulación de fuerzas sobre su grafo de vecinos más cercanos."
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body>
    <LandingPage client:only="react" onExplore={() => { window.location.href = '/galaxia'; }} />

    <style is:global>
      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        background: #1C1D1F;
        color: rgba(242, 239, 233, 0.72);
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      /* ================= PORTADA ================= */
      /* Todo el bloque está calcado de la referencia. Las dos unidades:
         `--cw`/`--ch` son la celda de la rejilla (48x30 estirada al viewport,
         así la silueta es idéntica en cualquier ventana) y `--u` es la unidad
         tipográfica, la celda de la referencia (12,6 px sobre 605 de ancho).
         `--u` se acota también por la altura para que en una ventana baja y
         ancha el titular no se coma la pantalla. Las posiciones van en
         porcentaje porque lo que las ancla es la silueta, no la tipografía. */
      .landing-overlay {
        --cols: 48;
        --rows: 30;
        --cw: calc(100vw / 48);
        --ch: calc(100vh / 30);
        --u: min(calc(100vw / 48), calc(100vh / 26));
        --light: #e6e6e6;
        --dark: #202020;
        --ink: #1a1a1a;

        position: fixed;
        inset: 0;
        z-index: 10000;
        overflow-y: auto;
        overflow-x: hidden;
        scroll-behavior: smooth;
        background-color: var(--dark);
        /* Space Grotesk, y no una neogrotesca neutra: desciende de Space
           Mono, así que comparte esqueleto con la tipografía de código y
           encaja con la rejilla de píxeles en vez de discutir con ella. Las
           formas raras —la 'g', la 'y', la 'k', los terminales cortados en
           diagonal— son las que le dan al titular el peso que un Helvetica a
           este tamaño no tiene.

           `--mono` es Space Mono, su hermana, y sólo la usa el bloque técnico:
           el guiño al aprendizaje profundo se lee como una salida de consola
           porque *es* una medición, no un eslogan. */
        --mono: "Space Mono", "IBM Plex Mono", ui-monospace, monospace;
        font-family: "Space Grotesk", "Helvetica Neue", "Liberation Sans", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* **Absoluto, no fijo.** `fixed` era el fallo del que se quejaba todo lo
         demás: la silueta se quedaba clavada en el sitio mientras su propio
         titular se iba hacia arriba —el texto está *colocado sobre* la
         silueta, así que verlos separarse es ver romperse el diseño— y la
         costura, que es la continuación de su última fila, se despegaba de
         ella y acababa flotando sobre un dibujo congelado. Sólo cuadraban en
         `scrollTop = 0`, que es justo cuando la costura está debajo del
         doblez y no se ve.

         La portada es **un cuadro**: se va como un cuadro, de una pieza y con
         su borde inferior deshilachado por delante. Nada de parallax entre el
         texto y la rejilla, por lo mismo — un dedo de desfase y el titular se
         sale de su masa clara. */
      .landing-grid-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        display: grid;
        z-index: 10001;
        pointer-events: none;
      }

      /* Sin bordes ni separaciones: en la referencia las dos masas son planas
         (#e6e6e6 y #202020 medidos, uniformes). Una línea de rejilla, por
         tenue que sea, convierte el dibujo en una hoja de cálculo. */
      .gcell {
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .gcell-l { background-color: var(--light); }
      .gcell-d { background-color: var(--dark); }

      .gnum {
        font-size: calc(min(var(--cw), var(--ch)) * 0.34);
        line-height: 1;
        font-weight: 400;
        color: rgba(32, 32, 32, 0.45);
      }

      /* Resplandor del puntero. `screen` sobre el oscuro suma luz azul; sobre
         el claro es casi invisible, que es lo que se ve en la referencia. */
      .landing-glow {
        position: fixed;
        left: 0;
        top: 0;
        width: calc(var(--cw) * 4.2);
        height: calc(var(--ch) * 4.2);
        margin-left: calc(var(--cw) * -2.1);
        margin-top: calc(var(--ch) * -2.1);
        border-radius: 50%;
        /* rgb(0,9,79) no es un azul elegido a ojo: es el color que, sumado
           por `screen` sobre el #202020 del fondo, da el rgb(32,40,101) que
           mide la referencia en el centro del resplandor. */
        background: radial-gradient(circle, rgb(0, 9, 79) 0%, rgba(0, 9, 79, 0) 65%);
        mix-blend-mode: screen;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.25s ease;
        z-index: 10002;
      }

      .landing-overlay-ui {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100vh;
        z-index: 10005;
        pointer-events: none;
      }

      .landing-overlay-ui > * { pointer-events: auto; }

      /* ---- Marca (arriba a la izquierda, sobre la masa clara) ---- */
      .landing-brand {
        position: absolute;
        left: 2.149%;
        top: 4.881%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 0.72);
        text-decoration: none;
        color: var(--ink);
      }

      .landing-brand-mark {
        width: calc(var(--u) * 1.27);
        height: calc(var(--u) * 1.27);
        display: block;
        flex: none;
      }

      .landing-brand-name {
        font-size: calc(var(--u) * 0.47);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.01em;
        letter-spacing: 0.005em;
      }

      /* ---- Navegación (arriba a la derecha) ---- */
      .landing-nav {
        position: absolute;
        right: 2.314%;
        top: 5.27%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 1.2);
      }

      .landing-nav-item {
        background: none;
        border: 0;
        padding: 0;
        margin: 0;
        font-family: inherit;
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.36);
        font-weight: 400;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--dark);
        cursor: pointer;
        transition: opacity 0.2s;
      }

      .landing-nav-item:hover { opacity: 0.55; }

      /* ---- Titular ---- */
      /* `top` es la caja de texto, no la altura de mayúscula: con
         line-height 1 la mayúscula cae ~0,09em por debajo del borde de la
         caja, y la referencia la quiere a 23,2% de la altura. */
      /* Tres líneas y no dos: partir «words / have / gravity.» convierte el
         titular en la columna que sostiene toda la masa clara, que es lo que
         antes hacía la silueta ella sola. El interlineado baja de 1,05 a 0,88
         porque a este cuerpo el espacio entre líneas se ve antes que las
         letras; el tracking negativo es el que cierra los huecos que deja
         Space Grotesk en mayúscula de caja baja. */
      .landing-title {
        position: absolute;
        left: 2.314%;
        top: 16.7%;
        margin: 0;
        /* El segundo término del `min()` es el que impide que el titular
           se coma la frontera. Tres líneas a 0,88 de interlineado miden
           unas doce filas de la rejilla, y en cuanto la ventana se hace
           muy apaisada (2560x1160 y más) las filas encogen mientras
           `--u` sigue mandada por el ancho: la cola de la 'y' de
           «gravity.» caía en las celdas oscuras de la fila 16 y se
           perdía en negro. Atarlo también a la altura de fila lo
           resuelve en el sitio donde está la causa. */
        font-size: min(calc(var(--u) * 3.7), calc(var(--ch) * 3.85));
        font-weight: 700;
        line-height: 0.88;
        letter-spacing: -0.045em;
        color: var(--ink);
      }

      /* ---- Guiño al aprendizaje profundo (hueco oscuro de abajo a la izq.) ---- */
      /* Va sobre el oscuro, así que la tinta se invierte: el `--light` es
         aquí el color del texto. La ecuación es lo único a cuerpo grande;
         las dos líneas de Space Mono que la enmarcan la presentan como lo
         que es, una medida, y no como un eslogan. */
      .landing-ml {
        position: absolute;
        left: 2.314%;
        top: 85.6%;
        color: var(--light);
      }

      .landing-ml p { margin: 0; }

      .landing-ml-tag {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.38);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.55);
      }

      .landing-ml-eq {
        font-size: calc(var(--u) * 0.95);
        font-weight: 500;
        letter-spacing: -0.015em;
        margin-top: calc(var(--u) * 0.34) !important;
        color: rgba(230, 230, 230, 0.95);
      }

      .landing-ml-foot {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.38);
        letter-spacing: 0.02em;
        margin-top: calc(var(--u) * 0.3) !important;
        color: rgba(230, 230, 230, 0.4);
      }

      /* ---- Nota (dentro de la isla clara de abajo a la derecha) ---- */
      .landing-note {
        position: absolute;
        left: 75.041%;
        top: 87.05%;
        width: 19.8%;
        color: #3a3a3a;
        font-size: calc(var(--u) * 0.437);
        line-height: 1.6;
      }

      .landing-note p { margin: 0; }

      .landing-attrib {
        font-family: var(--mono);
        margin-top: calc(var(--u) * 0.5) !important;
        font-size: calc(var(--u) * 0.32);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(32, 32, 32, 0.45);
      }

      /* ---- Transición de salida ---- */
      .landing-overlay.transitioning { pointer-events: none; }

      .landing-overlay.transitioning .landing-overlay-ui,
      .landing-overlay.transitioning .landing-glow,
      .landing-overlay.transitioning .landing-rooms-inner,
      .landing-overlay.transitioning .landing-scroll-indicator {
        opacity: 0;
        transition: opacity 0.35s ease;
      }

      .landing-overlay.transitioning .gcell-l {
        transform: translateX(-100vw);
        opacity: 0;
      }

      .landing-overlay.transitioning .gcell-d { opacity: 0; }

      /* Con la portada delante, el atlas de detrás no sólo sobra: asoma. La
         tira de herramientas y los raíles están fuera del overlay y se veían
         por encima del dibujo. Se esconden enteros, incluida la atribución
         —que no desaparece del sitio: la portada lleva la suya en la isla
         clara de abajo a la derecha. */
      .in-landing .galaxy-canvas { pointer-events: none; }
      .in-landing .side,
      .in-landing .rail,
      .in-landing .tools,
      .in-landing .held,
      .in-landing .go-home,
      .in-landing .attrib,
      .in-landing .zen-exit { display: none; }

      /* ---- Pantallas estrechas ---- */
      /* La silueta está pensada para 1,6:1. Estirada a un móvil, la isla de
         abajo a la derecha se vuelve una franja y el texto se sale de ella;
         se cambia por un fondo plano y flujo normal. */
      @media (max-width: 820px) {
        .landing-grid-bg, .landing-glow { display: none; }
        .landing-overlay { background-color: var(--light); }
        .landing-overlay-ui {
          position: relative;
          height: auto;
          min-height: 100vh;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          padding: 1.75rem;
          box-sizing: border-box;
        }
        .landing-brand, .landing-nav, .landing-title, .landing-note, .landing-ml {
          position: static;
          transform: none;
          width: auto;
        }
        /* Sin rejilla el fondo es claro, así que el bloque técnico invierte
           la tinta que tenía sobre el oscuro. */
        .landing-ml { color: var(--ink); margin-bottom: 2rem; }
        .landing-ml-tag { color: rgba(32, 32, 32, 0.5); font-size: 0.68rem; }
        .landing-ml-eq { color: var(--ink); font-size: 1.15rem; }
        .landing-ml-foot { color: rgba(32, 32, 32, 0.45); font-size: 0.68rem; }
        .landing-nav {
          justify-content: flex-start;
          gap: 1.5rem;
          margin-top: 1.25rem;
        }
        .landing-nav-item { font-size: 0.78rem; }
        .landing-brand-name { font-size: 0.82rem; }
        .landing-brand-mark { width: 26px; height: 26px; }
        /* `margin: auto 0` centra el titular en el hueco que dejan la marca
           arriba y la nota abajo, sin repartir el sobrante entre los cuatro
           bloques —que es lo que hacía `space-between` y dejaba la navegación
           flotando sola en mitad de la pantalla. */
        .landing-title {
          font-size: 3.1rem;
          margin: auto 0;
        }
        .landing-note {
          font-size: 0.88rem;
          max-width: 34ch;
        }
        .landing-attrib { font-size: 0.68rem; }
      }

      /* ================= ÍNDICE DE SALAS ================= */
      /* La mitad de abajo está hecha del **mismo material** que la portada:
         masas planas, celda cuadrada, dígitos de buscaminas, tipografía de la
         casa y **cero radio de borde**. Antes empezaba aquí, de golpe, una
         página web normal —tarjetas redondeadas, bordes translúcidos, un
         `translateY` al pasar por encima— y el corte decía «hasta aquí llegó
         el diseño». Tres decisiones lo cosen:

         - la **costura**: la última fila de la silueta sigue bajando y se
           erosiona hasta el fondo del índice, así que no hay línea de
           frontera, hay degradado de píxeles;
         - las placas **se tocan**: la rejilla lleva `gap: 1px` sobre un fondo
           tenue, así que la separación *es* una línea de la rejilla y las tres
           salas forman un solo bloque, como las celdas de arriba;
         - al pasar por encima, una sala abierta no se ilumina: **se
           invierte**. Es el gesto que la portada ya tenía a mano —una celda
           que cambia de bit— y el único que dice de qué está hecha la página. */

      /* Es un **botón**, no un adorno. Estaba dibujando una flecha que invita a
         bajar y con `pointer-events: none`: quien la pulsaba no obtenía nada,
         que es peor que no dibujarla. Ahora baja al índice con el
         `scroll-behavior: smooth` que el contenedor ya tenía. */
      .landing-scroll-indicator {
        position: absolute;
        left: 50%;
        bottom: 3%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        margin: 0;
        padding: 0.5rem 0.9rem;
        border: 0;
        background: none;
        font-family: var(--mono);
        font-size: 0.65rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.3);
        animation: landing-bounce 2s infinite;
        cursor: pointer;
        z-index: 10006;
        transition: color 0.15s linear;
      }
      .landing-scroll-indicator:hover { color: rgba(255, 255, 255, 0.7); }
      .landing-scroll-indicator svg { stroke-width: 1.5; }

      @keyframes landing-bounce {
        0%, 20%, 50%, 80%, 100% { transform: translate(-50%, 0); }
        40% { transform: translate(-50%, -6px); }
        60% { transform: translate(-50%, -3px); }
      }

      .landing-rooms {
        position: relative;
        z-index: 10006;
        width: 100%;
        min-height: 100vh;
        margin-top: 100vh;
        background-color: var(--dark);
        color: var(--light);
        overflow: hidden;
      }

      /* `width: 100%` y no `100vw`: la rejilla de arriba también mide el ancho
         del contenido, así que las 48 columnas de abajo caen exactamente en
         las mismas verticales. Con `100vw` se desalineaban lo que mide la
         barra de desplazamiento —hasta 15 px en la última columna— y el borde
         erosionado se veía pisado medio píxel. */
      .landing-seam-grid {
        display: grid;
        width: 100%;
        /* Misma altura de celda que la portada (`--ch`), o la erosión saldría
           con píxeles de otro tamaño y se leería como una textura distinta. */
        height: calc(var(--ch) * 7);
        grid-auto-rows: 1fr;
        pointer-events: none;
        user-select: none;
      }

      .landing-seam-flat { display: none; }

      /* ---- La erosión sigue mientras te vas ---- */
      /* En reposo la costura es el borde deshilachado del cuadro. Al bajar,
         **sigue deshilachándose**: cada celda lleva su `--t`, el punto del
         recorrido en el que le toca apagarse, y `--p` —la posición de scroll
         en alturas de ventana— va cruzando el campo de umbrales de arriba
         abajo. El frente se queda rondando el tercio inferior de la pantalla,
         así que lo que se ve es el pie del cuadro comiéndose a sí mismo
         mientras el índice sube por debajo.

         El factor 22 del `calc` es la pendiente: convierte el umbral en un
         corte casi seco (~4,5% de recorrido de penumbra). Un desvanecido
         largo aquí es lo que haría que esto pareciese una máscara de
         degradado y no una rejilla de celdas.

         `transition` a cero en la opacidad **es obligatorio**: `.gcell` lleva
         0,6 s heredados de la animación de salida, y con ellos cada celda
         llegaba medio segundo tarde — la erosión se arrastraba detrás del
         scroll como una estela sucia. El `transform` conserva su transición
         porque es el que usa la salida al atlas. */
      .landing-seam .gcell-l {
        opacity: clamp(0, calc((var(--t, 9) - var(--p, 0)) * 22), 1);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0s;
      }

      .landing-rooms-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: clamp(3.5rem, 9vh, 6.5rem) 4rem clamp(3rem, 7vh, 5rem);
      }

      /* ---- Encabezado del índice ---- */
      /* La regla que separa «index» de la cuenta de salas es la misma hairline
         que separa las placas: una sola línea recorre la página y va marcando
         los cortes, en vez de tres estilos de borde distintos. */
      .landing-rooms-tag {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        margin: 0 0 clamp(1.4rem, 3vh, 2.2rem);
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.45);
      }

      .landing-rooms-rule {
        flex: 1;
        height: 1px;
        background: rgba(230, 230, 230, 0.18);
      }

      /* Minúscula y punto final, como «words have gravity.»: es el mismo
         titular, una octava más abajo. El tracking negativo es el mismo
         (-0,045em) porque es el que cierra los huecos de Space Grotesk. */
      .landing-rooms-title {
        margin: 0 0 clamp(1.2rem, 2.5vh, 1.8rem);
        font-size: clamp(2.3rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 0.9;
        letter-spacing: -0.045em;
        color: var(--light);
      }

      .landing-rooms-lead {
        margin: 0;
        max-width: 58ch;
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        font-size: clamp(1rem, 1.5vw, 1.14rem);
        line-height: 1.62;
        color: rgba(230, 230, 230, 0.6);
      }

      /* ---- Las tres placas ---- */
      .landing-room-list {
        list-style: none;
        margin: clamp(3rem, 7vh, 4.75rem) 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        /* El hueco *es* la línea: el fondo del contenedor se ve por él. Así no
           hay dos bordes contiguos ni medio píxel de doble grosor. */
        gap: 1px;
        background: rgba(230, 230, 230, 0.18);
        border: 1px solid rgba(230, 230, 230, 0.18);
      }

      .landing-room-list > li { display: flex; }

      /* ---- La llegada ---- */
      /* Bajar tenía dos partes rotas: el cuadro no se iba (arriba) y el índice
         no llegaba — aparecía ya montado, como si hubiera estado ahí todo el
         rato. Ahora se dibuja en dos tiempos: primero los filetes de la
         rejilla, y encima cae el contenido de cada placa con 0,1 s de retraso
         entre ellas.

         Se anima el **contenido**, nunca la placa: con `opacity` sobre el
         `<li>` se veía por debajo el fondo del contenedor, que es el color de
         los filetes, y las tres salas entraban como un rectángulo gris claro.

         Y el movimiento va en `steps(6)`: aquí nada se desliza. Las cosas
         caen en la celda que les toca, a saltos, como todo lo demás de esta
         página. */
      .landing-rooms-inner .landing-room-list {
        background-color: transparent;
        border-color: transparent;
        transition: background-color 0.3s linear, border-color 0.3s linear;
      }

      .landing-rooms-inner .landing-room > *,
      .landing-rooms-head > * {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.3s linear, transform 0.42s steps(6);
      }

      .landing-rooms-inner.is-in .landing-room-list {
        background-color: rgba(230, 230, 230, 0.18);
        border-color: rgba(230, 230, 230, 0.18);
        transition-delay: 0.12s;
      }

      .landing-rooms-inner.is-in .landing-room > *,
      .landing-rooms-inner.is-in .landing-rooms-head > * {
        opacity: 1;
        transform: none;
      }

      .landing-rooms-inner.is-in .landing-rooms-title { transition-delay: 0.05s; }
      .landing-rooms-inner.is-in .landing-rooms-lead { transition-delay: 0.1s; }
      .landing-rooms-inner.is-in > ol > li:nth-child(1) .landing-room > * { transition-delay: 0.2s; }
      .landing-rooms-inner.is-in > ol > li:nth-child(2) .landing-room > * { transition-delay: 0.3s; }
      .landing-rooms-inner.is-in > ol > li:nth-child(3) .landing-room > * { transition-delay: 0.4s; }

      .landing-room {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-height: 27rem;
        padding: clamp(1.6rem, 2.3vw, 2.15rem);
        background-color: var(--dark);
        color: var(--light);
        text-decoration: none;
        /* 0,12 s y lineal: la inversión tiene que leerse como un bit que
           cambia, no como un fundido. Con la curva suave de las tarjetas de
           antes el efecto parecía un `hover` de bootstrap. */
        transition: background-color 0.12s linear, color 0.12s linear;
      }

      a.landing-room:hover,
      a.landing-room:focus-visible {
        background-color: var(--light);
        color: var(--ink);
      }

      /* El foco se dibuja **después** de la inversión y en tinta oscura: con
         el contorno claro del navegador sobre la placa ya invertida no se veía
         nada. */
      a.landing-room:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: -7px;
      }

      .landing-room-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .landing-room-id {
        font-family: var(--mono);
        font-weight: 700;
        font-size: 1.3rem;
        line-height: 1;
        letter-spacing: 0.03em;
      }

      .landing-room-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.63rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.55;
      }

      /* Cuadrado y no círculo: aquí no hay una sola esquina redondeada. Lleno
         = la sala existe; hueco = todavía no. */
      .landing-room-status i {
        width: 7px;
        height: 7px;
        flex: none;
        box-shadow: inset 0 0 0 1px currentColor;
      }
      .landing-room-status i.dot-on { background: currentColor; }

      /* El emblema hereda `currentColor`, así que se invierte con la placa sin
         una sola regla más. */
      .landing-glyph {
        --gc: 9px;
        display: grid;
        grid-template-columns: repeat(10, var(--gc));
        grid-auto-rows: var(--gc);
        margin: clamp(1.9rem, 4vh, 2.9rem) 0 clamp(1.5rem, 3vh, 2.1rem);
      }
      .landing-glyph .gp { display: block; }
      .landing-glyph .gp-on { background: currentColor; }

      .landing-room-title {
        margin: 0 0 0.85rem;
        font-size: clamp(1.35rem, 2.1vw, 1.68rem);
        font-weight: 700;
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      /* `opacity` y no un color fijo: el texto secundario tiene que seguir
         siendo secundario en las dos tintas de la placa. */
      .landing-room-desc {
        flex: 1;
        margin: 0 0 2rem;
        max-width: 46ch;
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        font-size: 0.92rem;
        line-height: 1.62;
        opacity: 0.62;
      }

      .landing-room-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding-top: 1rem;
        border-top: 1px solid color-mix(in srgb, currentColor 28%, transparent);
        font-family: var(--mono);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      /* `steps(2)`: el salto de la flecha va a saltos, como todo lo demás. */
      .landing-room-action svg {
        flex: none;
        transition: transform 0.12s steps(2);
      }
      a.landing-room:hover .landing-room-action svg { transform: translateX(5px); }

      /* La sala que no existe se apaga **con la tinta**, no con `opacity` en la
         placa: media transparencia dejaría ver el fondo del contenedor y la
         placa saldría más clara que sus dos vecinas, que es lo contrario de lo
         que hay que decir. */
      .landing-room-shut {
        color: rgba(230, 230, 230, 0.38);
        cursor: default;
      }
      .landing-room-shut .landing-room-desc { opacity: 0.82; }

      /* ---- Pie ---- */
      .landing-rooms-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        margin-top: clamp(2.5rem, 5vh, 3.5rem);
        padding-top: 1.4rem;
        border-top: 1px solid rgba(230, 230, 230, 0.18);
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.4);
      }

      .landing-rooms-links {
        display: flex;
        gap: 1.8rem;
      }

      .landing-rooms-links a {
        color: rgba(230, 230, 230, 0.68);
        text-decoration: none;
        transition: color 0.12s linear;
      }
      .landing-rooms-links a:hover { color: var(--light); }

      /* ---- Pantallas estrechas ---- */
      @media (max-width: 1080px) {
        .landing-rooms-inner { padding-left: 2.5rem; padding-right: 2.5rem; }
        .landing-room-list { grid-template-columns: 1fr; }
        .landing-room { min-height: 0; }
        .landing-room-desc { max-width: 62ch; }
      }

      @media (max-width: 820px) {
        .landing-scroll-indicator { display: none; }
        /* Sin la rejilla de la portada el borde de arriba es claro y plano, así
           que la erosión tiene que arrancar de una fila entera encendida. */
        .landing-seam { display: none; }
        .landing-seam-flat { display: grid; }
        .landing-rooms {
          margin-top: 0;
          min-height: 0;
        }
        .landing-rooms-inner { padding: 3.5rem 1.75rem 3rem; }
        .landing-rooms-title { font-size: 2.6rem; }
        .landing-room { padding: 1.75rem; }
        /* Sin puntero fino no hay `hover`: la inversión se pierde, así que la
           placa abierta se distingue por la tinta plena del pie de acción. */
        .landing-rooms-foot { font-size: 0.62rem; }
      }

      @media (max-width: 560px) {
        .landing-glyph { --gc: 8px; }
        .landing-rooms-title { font-size: 2.15rem; }
        .landing-rooms-tag { gap: 0.8rem; font-size: 0.62rem; }
      }

      /* ---- Sin movimiento ---- */
      /* La erosión al bajar y la entrada del índice son las dos cosas que hay
         que apagar aquí; el resto de la página no se mueve sola. Y hay que
         apagarlas dejando el **estado final**, no el inicial: sin esto, quien
         pide menos movimiento se queda con las tres placas vacías para
         siempre, que es un fallo, no una preferencia. */
      @media (prefers-reduced-motion: reduce) {
        .landing-overlay { scroll-behavior: auto; }
        .landing-scroll-indicator { animation: none; }
        .landing-seam .gcell-l { opacity: 1; }
        .landing-rooms-inner .landing-room-list {
          background-color: rgba(230, 230, 230, 0.18);
          border-color: rgba(230, 230, 230, 0.18);
        }
        .landing-rooms-inner .landing-room > *,
        .landing-rooms-head > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
