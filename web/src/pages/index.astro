---
import LandingPage from "../components/LandingPage.tsx";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TensorMesh · La Forma de la Mente Artificial</title>
    <meta
      name="description"
      content="TensorMesh: Galería interactiva 3D de algoritmos de inteligencia artificial, redes neuronales, optimización y estructuras matemáticas simuladas en tiempo real con WebGPU."
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body>
    <LandingPage client:only="react" onExplore={() => { window.location.href = '/embedding-nebula'; }} />

    <style is:global>
      * {
        box-sizing: border-box;
        scrollbar-width: thin;
        scrollbar-color: rgba(230, 230, 230, 0.28) #181818;
      }

      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #181818;
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(230, 230, 230, 0.28);
        border: 1px solid #181818;
        border-radius: 0;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #e6e6e6;
      }

      html, body {
        margin: 0;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        background: #1C1D1F;
        color: rgba(242, 239, 233, 0.72);
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      /* ================= PORTADA ================= */
      /* Todo el bloque está calcado de la referencia. Las dos unidades:
         `--cw`/`--ch` son la celda de la rejilla (48x30 estirada al viewport,
         así la silueta es idéntica en cualquier ventana) y `--u` es la unidad
         tipográfica, la celda de la referencia (12,6 px sobre 605 de ancho).
         `--u` se acota también por la altura para que en una ventana baja y
         ancha el titular no se coma la pantalla. Las posiciones van en
         porcentaje porque lo que las ancla es la silueta, no la tipografía. */
      .landing-overlay {
        --cols: 48;
        --rows: 30;
        --cw: calc(100vw / 48);
        --ch: calc(100vh / 30);
        --u: min(calc(100vw / 48), calc(100vh / 26));
        --light: #e6e6e6;
        --dark: #202020;
        --ink: #1a1a1a;

        position: fixed;
        inset: 0;
        z-index: 10000;
        overflow-y: auto;
        overflow-x: hidden;
        scroll-behavior: smooth;
        background-color: var(--dark);
        /* Space Grotesk, y no una neogrotesca neutra: desciende de Space
           Mono, así que comparte esqueleto con la tipografía de código y
           encaja con la rejilla de píxeles en vez de discutir con ella. Las
           formas raras —la 'g', la 'y', la 'k', los terminales cortados en
           diagonal— son las que le dan al titular el peso que un Helvetica a
           este tamaño no tiene.

           `--mono` es Space Mono, su hermana, y sólo la usa el bloque técnico:
           el guiño al aprendizaje profundo se lee como una salida de consola
           porque *es* una medición, no un eslogan. */
        --mono: "Space Mono", "IBM Plex Mono", ui-monospace, monospace;
        font-family: "Space Grotesk", "Helvetica Neue", "Liberation Sans", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* **Absoluto, no fijo.** `fixed` era el fallo del que se quejaba todo lo
         demás: la silueta se quedaba clavada en el sitio mientras su propio
         titular se iba hacia arriba —el texto está *colocado sobre* la
         silueta, así que verlos separarse es ver romperse el diseño— y la
         costura, que es la continuación de su última fila, se despegaba de
         ella y acababa flotando sobre un dibujo congelado. Sólo cuadraban en
         `scrollTop = 0`, que es justo cuando la costura está debajo del
         doblez y no se ve.

         La portada es **un cuadro**: se va como un cuadro, de una pieza y con
         su borde inferior deshilachado por delante. Nada de parallax entre el
         texto y la rejilla, por lo mismo — un dedo de desfase y el titular se
         sale de su masa clara. */
      .landing-grid-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        display: grid;
        z-index: 10001;
        pointer-events: none;
      }

      /* Sin bordes ni separaciones: en la referencia las dos masas son planas
         (#e6e6e6 y #202020 medidos, uniformes). Una línea de rejilla, por
         tenue que sea, convierte el dibujo en una hoja de cálculo. */
      .gcell {
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .gcell-l { background-color: var(--light); }
      .gcell-d { background-color: var(--dark); }

      .gnum {
        font-size: calc(min(var(--cw), var(--ch)) * 0.34);
        line-height: 1;
        font-weight: 400;
        color: rgba(32, 32, 32, 0.45);
      }

      /* Resplandor del puntero. `screen` sobre el oscuro suma luz azul; sobre
         el claro es casi invisible, que es lo que se ve en la referencia. */
      .landing-glow {
        position: fixed;
        left: 0;
        top: 0;
        width: calc(var(--cw) * 4.2);
        height: calc(var(--ch) * 4.2);
        margin-left: calc(var(--cw) * -2.1);
        margin-top: calc(var(--ch) * -2.1);
        border-radius: 50%;
        /* rgb(0,9,79) no es un azul elegido a ojo: es el color que, sumado
           por `screen` sobre el #202020 del fondo, da el rgb(32,40,101) que
           mide la referencia en el centro del resplandor. */
        background: radial-gradient(circle, rgb(0, 9, 79) 0%, rgba(0, 9, 79, 0) 65%);
        mix-blend-mode: screen;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.25s ease;
        z-index: 10002;
      }

      .landing-overlay-ui {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100vh;
        z-index: 10005;
        pointer-events: none;
      }

      .landing-overlay-ui > * { pointer-events: auto; }

      /* ================= HEADER STICKY ================= */
      .landing-sticky-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 10020;
        box-sizing: border-box;
        padding: calc(var(--u) * 0.42) 2.314%;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.25s ease,
                    padding 0.25s ease,
                    backdrop-filter 0.25s ease,
                    box-shadow 0.25s ease;
      }

      .landing-sticky-header.is-scrolled {
        background-color: rgba(28, 29, 31, 0.88);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom-color: rgba(230, 230, 230, 0.14);
        padding: calc(var(--u) * 0.26) 2.314%;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
      }

      .landing-header-inner {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
      }

      /* ---- Marca / Logotipo ---- */
      /* Archivo Black y no Space Grotesk 700: la marca es el único sitio
         donde «más peso» no basta — hace falta un dibujo pensado para ser
         negro. Es una grotesca ultra-bold de caja ancha, hermana de espíritu
         de las masas planas de la rejilla; en minúscula, una sola pieza:
         «tensormesh» se lee como un nombre, no como dos palabras sueltas. */
      .landing-brand-link {
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 0.62);
        text-decoration: none;
        color: var(--ink);
        transition: color 0.25s ease, transform 0.2s ease;
      }

      .landing-brand-link:hover {
        transform: translateY(-1px);
      }

      .landing-sticky-header.is-scrolled .landing-brand-link {
        color: var(--light);
      }

      .landing-brand-mark {
        width: calc(var(--u) * 1.62);
        height: calc(var(--u) * 1.62);
        display: block;
        flex: none;
      }

      /* Una sola línea, grande y negra. El tracking ligeramente negativo
         cierra los huecos que Archivo Black deja entre letras a este cuerpo.
         La caja viene ya con las mayúsculas de la casa («TensorMesh»), así
         que aquí no se toca el caso del texto. */
      .landing-brand-text {
        font-family: "Archivo Black", "Space Grotesk", Arial, sans-serif;
        font-size: calc(var(--u) * 0.92);
        font-weight: 400; /* Archivo Black sólo trae un peso: el suyo */
        line-height: 1;
        letter-spacing: -0.028em;
        white-space: nowrap;
        transform: translateY(0.04em); /* centra la caja x con el glifo */
      }

      /* ---- Toggle de Idioma ---- */
      .landing-lang-toggle {
        display: inline-flex;
        gap: 1px;
        background: rgba(32, 32, 32, 0.14);
        border: 1px solid rgba(32, 32, 32, 0.18);
        border-radius: 6px;
        overflow: hidden;
        transition: background-color 0.25s ease, border-color 0.25s ease;
      }

      .landing-sticky-header.is-scrolled .landing-lang-toggle {
        background: rgba(230, 230, 230, 0.08);
        border-color: rgba(230, 230, 230, 0.18);
      }

      .landing-lang-btn {
        background: rgba(255, 255, 255, 0.42);
        border: 0;
        padding: calc(var(--u) * 0.16) calc(var(--u) * 0.5);
        margin: 0;
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.42);
        font-weight: 500;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(32, 32, 32, 0.55);
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
      }

      .landing-lang-btn:hover {
        background: rgba(255, 255, 255, 0.85);
        color: var(--dark);
      }

      .landing-lang-btn.on {
        background: var(--dark);
        color: var(--light);
        font-weight: 600;
      }

      .landing-sticky-header.is-scrolled .landing-lang-btn {
        background: transparent;
        color: rgba(230, 230, 230, 0.55);
      }

      .landing-sticky-header.is-scrolled .landing-lang-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        color: var(--light);
      }

      .landing-sticky-header.is-scrolled .landing-lang-btn.on {
        background: var(--light);
        color: var(--ink);
        font-weight: 600;
      }

      .landing-mobile-toggle {
        display: none;
        background: none;
        border: 1px solid rgba(32, 32, 32, 0.2);
        border-radius: 4px;
        padding: 0.4rem;
        color: var(--ink);
        cursor: pointer;
      }

      .landing-sticky-header.is-scrolled .landing-mobile-toggle {
        border-color: rgba(230, 230, 230, 0.2);
        color: var(--light);
      }

      /* ---- Titular ---- */
      /* `top` es la caja de texto, no la altura de mayúscula: con
         line-height 1 la mayúscula cae ~0,09em por debajo del borde de la
         caja, y la referencia la quiere a 23,2% de la altura. */
      /* Tres líneas y no dos: partir «words / have / gravity.» convierte el
         titular en la columna que sostiene toda la masa clara, que es lo que
         antes hacía la silueta ella sola. El interlineado baja de 1,05 a 0,88
         porque a este cuerpo el espacio entre líneas se ve antes que las
         letras; el tracking negativo es el que cierra los huecos que deja
         Space Grotesk en mayúscula de caja baja. */
      .landing-title {
        position: absolute;
        left: 2.314%;
        top: 16.7%;
        margin: 0;
        /* El segundo término del `min()` es el que impide que el titular
           se coma la frontera. Tres líneas a 0,88 de interlineado miden
           unas doce filas de la rejilla, y en cuanto la ventana se hace
           muy apaisada (2560x1160 y más) las filas encogen mientras
           `--u` sigue mandada por el ancho: la cola de la 'y' de
           «gravity.» caía en las celdas oscuras de la fila 16 y se
           perdía en negro. Atarlo también a la altura de fila lo
           resuelve en el sitio donde está la causa. */
        font-size: min(calc(var(--u) * 3.7), calc(var(--ch) * 3.85));
        font-weight: 700;
        line-height: 0.88;
        letter-spacing: -0.045em;
        color: var(--ink);
      }

      /* ---- Guiño al aprendizaje profundo (hueco oscuro de abajo a la izq.) ---- */
      /* Va sobre el oscuro, así que la tinta se invierte: el `--light` es
         aquí el color del texto. La ecuación es lo único a cuerpo grande;
         las dos líneas de Space Mono que la enmarcan la presentan como lo
         que es, una medida, y no como un eslogan. */
      .landing-ml {
        position: absolute;
        left: 2.314%;
        top: 85.6%;
        color: var(--light);
      }

      .landing-ml p { margin: 0; }

      .landing-ml-tag {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.38);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.55);
      }

      .landing-ml-eq {
        font-size: calc(var(--u) * 0.95);
        font-weight: 500;
        letter-spacing: -0.015em;
        margin-top: calc(var(--u) * 0.34) !important;
        color: rgba(230, 230, 230, 0.95);
      }

      .landing-ml-foot {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.38);
        letter-spacing: 0.02em;
        margin-top: calc(var(--u) * 0.3) !important;
        color: rgba(230, 230, 230, 0.4);
      }

      /* ---- Nota (esquina inferior izquierda) ---- */
      .landing-note {
        position: absolute;
        left: 2.314%;
        bottom: 5.5%;
        max-width: 44ch;
        color: #ffffff;
        font-size: calc(var(--u) * 0.52);
        font-weight: 600;
        line-height: 1.5;
        letter-spacing: -0.01em;
      }

      .landing-note p { margin: 0; }

      .landing-attrib {
        font-family: var(--mono);
        margin-top: calc(var(--u) * 0.35) !important;
        font-size: calc(var(--u) * 0.33);
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
      }

      /* ---- Transición de salida ---- */
      .landing-overlay.transitioning { pointer-events: none; }

      .landing-overlay.transitioning .landing-overlay-ui,
      .landing-overlay.transitioning .landing-glow,
      .landing-overlay.transitioning .landing-rooms-inner,
      .landing-overlay.transitioning .landing-scroll-indicator {
        opacity: 0;
        transition: opacity 0.35s ease;
      }

      .landing-overlay.transitioning .gcell-l {
        transform: translateX(-100vw);
        opacity: 0;
      }

      .landing-overlay.transitioning .gcell-d { opacity: 0; }

      /* Con la portada delante, el atlas de detrás no sólo sobra: asoma. La
         tira de herramientas y los raíles están fuera del overlay y se veían
         por encima del dibujo. Se esconden enteros, incluida la atribución
         —que no desaparece del sitio: la portada lleva la suya en la isla
         clara de abajo a la derecha. */
      .in-landing .galaxy-canvas { pointer-events: none; }
      .in-landing .side,
      .in-landing .rail,
      .in-landing .tools,
      .in-landing .held,
      .in-landing .go-home,
      .in-landing .attrib,
      .in-landing .zen-exit { display: none; }

      /* ---- Pantallas estrechas ---- */
      /* La silueta está pensada para 1,6:1. Estirada a un móvil, la isla de
         abajo a la derecha se vuelve una franja y el texto se sale de ella;
         se cambia por un fondo plano y flujo normal. */
      @media (max-width: 820px) {
        .landing-grid-bg, .landing-glow { display: none; }
        .landing-overlay { background-color: var(--light); }
        .landing-overlay-ui {
          position: relative;
          height: auto;
          min-height: 100vh;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          padding: 5rem 1.75rem 1.75rem;
          box-sizing: border-box;
        }
        .landing-title, .landing-note, .landing-ml {
          position: static;
          transform: none;
          width: auto;
        }
        /* Sin rejilla el fondo es claro, así que el bloque técnico invierte
           la tinta que tenía sobre el oscuro. */
        .landing-ml { color: var(--ink); margin-bottom: 2rem; }
        .landing-ml-tag { color: rgba(32, 32, 32, 0.5); font-size: 0.68rem; }
        .landing-ml-eq { color: var(--ink); font-size: 1.15rem; }
        .landing-ml-foot { color: rgba(32, 32, 32, 0.45); font-size: 0.68rem; }
        .landing-brand-mark { width: 26px; height: 26px; }
        .landing-brand-text { font-size: 1.18rem; letter-spacing: -0.02em; }
        /* `margin: auto 0` centra el titular en el hueco que dejan la marca
           arriba y la nota abajo, sin repartir el sobrante entre los cuatro
           bloques —que es lo que hacía `space-between` y dejaba la navegación
           flotando sola en mitad de la pantalla. */
        .landing-title {
          font-size: 3.1rem;
          margin: auto 0;
        }
        .landing-note {
          font-size: 1.05rem;
          font-weight: 600;
          line-height: 1.5;
          max-width: 38ch;
        }
        .landing-attrib { font-size: 0.72rem; font-weight: 500; }

        /* Header móvil */
        .landing-sticky-header {
          padding: 0.75rem 1.25rem;
          background: rgba(230, 230, 230, 0.95);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border-bottom: 1px solid rgba(32, 32, 32, 0.1);
        }
        .landing-sticky-header.is-scrolled {
          background-color: rgba(28, 29, 31, 0.96);
          border-bottom-color: rgba(230, 230, 230, 0.15);
        }
      }

      /* ================= ÍNDICE DE SALAS ================= */
      /* La mitad de abajo está hecha del **mismo material** que la portada:
         masas planas, celda cuadrada, dígitos de buscaminas, tipografía de la
         casa y **cero radio de borde**. Antes empezaba aquí, de golpe, una
         página web normal —tarjetas redondeadas, bordes translúcidos, un
         `translateY` al pasar por encima— y el corte decía «hasta aquí llegó
         el diseño». Tres decisiones lo cosen:

         - la **costura**: la última fila de la silueta sigue bajando y se
           erosiona hasta el fondo del índice, así que no hay línea de
           frontera, hay degradado de píxeles;
         - las placas **se tocan**: la rejilla lleva `gap: 1px` sobre un fondo
           tenue, así que la separación *es* una línea de la rejilla y las tres
           salas forman un solo bloque, como las celdas de arriba;
         - al pasar por encima, una sala abierta no se ilumina: **se invierte**. */

      /* ================= ÍNDICE DE SALAS ================= */
      /* La mitad de abajo está hecha del **mismo material** que la portada:
         masas planas, celda cuadrada, dígitos de buscaminas, tipografía de la
         casa y **cero radio de borde**. Tres decisiones lo cosen:

         - la **costura**: la última fila de la silueta sigue bajando y se
           erosiona hasta el fondo del índice;
         - la **rejilla de fondo**: continúa las 48 columnas con celdas claras y
           oscuras y sus dígitos de vecindad;
         - las placas **se tocan**: la rejilla lleva `gap: 1px` sobre un fondo
           tenue, así que la separación es una línea de la rejilla;
         - al pasar por encima, una sala abierta no se ilumina: **se invierte**. */

      /* ---- Indicador de Scroll pixel-art ---- */
      .landing-scroll-indicator {
        position: absolute;
        left: 50%;
        bottom: 3.2%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
        padding: 0.42rem 0.85rem;
        border: 1px solid rgba(230, 230, 230, 0.25);
        background: rgba(32, 32, 32, 0.88);
        font-family: var(--mono);
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.75);
        animation: landing-pixel-pulse 1.8s steps(2) infinite;
        cursor: pointer;
        z-index: 10006;
        transition: background-color 0.12s linear, color 0.12s linear, border-color 0.12s linear;
      }

      .landing-scroll-indicator:hover {
        background: var(--light);
        color: var(--ink);
        border-color: var(--light);
        animation-play-state: paused;
      }

      .landing-scroll-indicator svg {
        flex: none;
        display: block;
      }

      @keyframes landing-pixel-pulse {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, 4px); }
      }

      .landing-rooms {
        position: relative;
        z-index: 10006;
        width: 100%;
        min-height: 100vh;
        margin-top: 100vh;
        background-color: var(--dark);
        background-image:
          linear-gradient(to right, rgba(230, 230, 230, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(230, 230, 230, 0.03) 1px, transparent 1px);
        background-size: var(--cw) var(--ch);
        color: var(--light);
        overflow: hidden;
      }

      /* ---- Línea de cuadrados blancos separadora en la parte superior ---- */
      .landing-pixel-separator {
        display: grid;
        grid-template-columns: repeat(var(--cols), 1fr);
        width: 100%;
        height: min(14px, calc(var(--ch) * 0.38));
        gap: 1px;
        background: rgba(230, 230, 230, 0.22);
        border-top: 1px solid rgba(230, 230, 230, 0.22);
        border-bottom: 1px solid rgba(230, 230, 230, 0.22);
        position: relative;
        z-index: 10006;
        user-select: none;
        pointer-events: none;
      }

      .pixel-sep-cell {
        display: block;
        background-color: var(--light);
        height: 100%;
        opacity: 0.9;
      }

      .landing-rooms-inner {
        position: relative;
        z-index: 10005;
        max-width: 1180px;
        margin: 0 auto;
        padding: clamp(2.5rem, 5vh, 4rem) 4rem clamp(3rem, 7vh, 5rem);
      }

      .landing-rooms-head {
        display: flex;
        flex-direction: column;
        max-width: 64ch;
      }

      .landing-rooms-title {
        margin: 0 0 clamp(1rem, 2vh, 1.4rem);
        font-size: clamp(2.2rem, 4.2vw, 3.6rem);
        font-weight: 700;
        line-height: 0.92;
        letter-spacing: -0.045em;
        color: var(--light);
      }

      .landing-rooms-lead {
        margin: 0;
        max-width: 54ch;
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        font-size: clamp(0.92rem, 1.3vw, 1.05rem);
        line-height: 1.6;
        color: rgba(230, 230, 230, 0.65);
      }

      /* ---- Las tres placas ---- */
      .landing-room-list {
        list-style: none;
        margin: clamp(3rem, 7vh, 4.75rem) 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: rgba(230, 230, 230, 0.18);
        border: 1px solid rgba(230, 230, 230, 0.18);
      }

      .landing-room-list > li { display: flex; }

      .landing-rooms-inner .landing-room-list {
        background-color: transparent;
        border-color: transparent;
        transition: background-color 0.3s linear, border-color 0.3s linear;
      }

      .landing-rooms-inner .landing-room > *,
      .landing-rooms-head > * {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.3s linear, transform 0.42s steps(6);
      }

      .landing-rooms-inner.is-in .landing-room-list {
        background-color: rgba(230, 230, 230, 0.18);
        border-color: rgba(230, 230, 230, 0.18);
        transition-delay: 0.12s;
      }

      .landing-rooms-inner.is-in .landing-room > *,
      .landing-rooms-inner.is-in .landing-rooms-head > * {
        opacity: 1;
        transform: none;
      }

      .landing-rooms-inner.is-in .landing-rooms-title { transition-delay: 0.05s; }
      .landing-rooms-inner.is-in .landing-rooms-lead { transition-delay: 0.1s; }
      .landing-rooms-inner.is-in > ol > li:nth-child(1) .landing-room > * { transition-delay: 0.2s; }
      .landing-rooms-inner.is-in > ol > li:nth-child(2) .landing-room > * { transition-delay: 0.3s; }
      .landing-rooms-inner.is-in > ol > li:nth-child(3) .landing-room > * { transition-delay: 0.4s; }

      .landing-room {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-height: 27rem;
        padding: clamp(1.6rem, 2.3vw, 2.15rem);
        background-color: var(--dark);
        color: var(--light);
        text-decoration: none;
        transition: background-color 0.12s linear, color 0.12s linear;
      }

      a.landing-room:hover,
      a.landing-room:focus-visible {
        background-color: var(--light);
        color: var(--ink);
      }

      a.landing-room:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: -7px;
      }

      .landing-room-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .landing-room-id {
        font-family: var(--mono);
        font-weight: 700;
        font-size: 1.3rem;
        line-height: 1;
        letter-spacing: 0.03em;
      }

      .landing-room-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.63rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.55;
      }

      .landing-room-status i {
        width: 7px;
        height: 7px;
        flex: none;
        box-shadow: inset 0 0 0 1px currentColor;
      }
      .landing-room-status i.dot-on { background: currentColor; }

      .landing-glyph {
        --gc: 9px;
        display: grid;
        grid-template-columns: repeat(10, var(--gc));
        grid-auto-rows: var(--gc);
        margin: clamp(1.9rem, 4vh, 2.9rem) 0 clamp(1.5rem, 3vh, 2.1rem);
      }
      .landing-glyph .gp { display: block; }
      .landing-glyph .gp-on { background: currentColor; }

      /* ---- Miniatura de Render Real (WebGPU) ---- */
      .landing-room-thumb-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9.5;
        margin: clamp(1.4rem, 3vh, 2rem) 0 clamp(1.2rem, 2.5vh, 1.8rem);
        background: #0d0f14;
        border: 1px solid rgba(230, 230, 230, 0.2);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .landing-room-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
      }

      a.landing-room:hover .landing-room-thumb {
        transform: scale(1.06);
      }

      .landing-room-heading {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin: 0 0 0.85rem;
      }

      .landing-room-heading .landing-glyph {
        --gc: 5px;
        margin: 0;
        flex: none;
      }

      .landing-room-title {
        margin: 0;
        font-size: clamp(1.35rem, 2.1vw, 1.68rem);
        font-weight: 700;
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      .landing-room-desc {
        flex: 1;
        margin: 0 0 2rem;
        max-width: 46ch;
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        font-size: 0.92rem;
        line-height: 1.62;
        opacity: 0.62;
      }

      .landing-room-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding-top: 1rem;
        border-top: 1px solid color-mix(in srgb, currentColor 28%, transparent);
        font-family: var(--mono);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .landing-room-action svg {
        flex: none;
        transition: transform 0.12s steps(2);
      }
      a.landing-room:hover .landing-room-action svg { transform: translateX(5px); }

      /* ---- Pie ---- */
      .landing-rooms-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        margin-top: clamp(2.5rem, 5vh, 3.5rem);
        padding-top: 1.4rem;
        border-top: 1px solid rgba(230, 230, 230, 0.18);
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.4);
      }

      .landing-rooms-links {
        display: flex;
        gap: 1.8rem;
      }

      .landing-rooms-links a {
        color: rgba(230, 230, 230, 0.68);
        text-decoration: none;
        transition: color 0.12s linear;
      }
      .landing-rooms-links a:hover { color: var(--light); }

      /* ---- Pantallas estrechas ---- */
      @media (max-width: 1080px) {
        .landing-rooms-inner { padding-left: 2.5rem; padding-right: 2.5rem; }
        .landing-room-list { grid-template-columns: 1fr; }
        .landing-room { min-height: 0; }
        .landing-room-desc { max-width: 62ch; }
      }

      @media (max-width: 820px) {
        .landing-scroll-indicator { display: none; }
        .landing-seam { display: none; }
        .landing-seam-flat { display: grid; }
        .landing-rooms {
          margin-top: 0;
          min-height: 0;
        }
        .landing-rooms-inner { padding: 3.5rem 1.75rem 3rem; }
        .landing-rooms-title { font-size: 2.6rem; }
        .landing-room { padding: 1.75rem; }
        .landing-rooms-foot { font-size: 0.62rem; }
      }

      @media (max-width: 560px) {
        .landing-glyph { --gc: 8px; }
        .landing-rooms-title { font-size: 2.15rem; }
        .landing-rooms-tag { gap: 0.8rem; font-size: 0.62rem; }
      }

      /* ---- Sin movimiento ---- */
      @media (prefers-reduced-motion: reduce) {
        .landing-overlay { scroll-behavior: auto; }
        .landing-scroll-indicator { animation: none; }
        .landing-seam .gcell-l { opacity: 1; }
        .landing-rooms-inner .landing-room-list {
          background-color: rgba(230, 230, 230, 0.18);
          border-color: rgba(230, 230, 230, 0.18);
        }
        .landing-rooms-inner .landing-room > *,
        .landing-rooms-head > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* ================= WIDGET DE AUTOR (JHONGDLP) ================= */
      .author-floating-widget {
        position: fixed;
        bottom: 1.6rem;
        right: 1.8rem;
        z-index: 10025;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        pointer-events: auto;
        user-select: none;
      }

      /* ---- Botón principal (trigger) ---- */
      .author-trigger-btn {
        display: flex;
        align-items: center;
        gap: 0.72rem;
        padding: 0.36rem 0.9rem 0.36rem 0.36rem;
        background: rgba(26, 27, 30, 0.92);
        border: 1px solid rgba(230, 230, 230, 0.22);
        border-radius: 999px;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 4px 22px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
        cursor: pointer;
        color: var(--light);
        text-decoration: none;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
      }

      .author-trigger-btn:hover,
      .author-floating-widget.is-open .author-trigger-btn {
        background: rgba(36, 38, 44, 0.98);
        border-color: rgba(230, 230, 230, 0.5);
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
      }

      .author-trigger-btn:focus-visible {
        outline: 2px solid var(--light);
        outline-offset: 2px;
      }

      /* ---- Avatar ---- */
      .author-avatar-frame {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        overflow: hidden;
        border: 1.75px solid rgba(230, 230, 230, 0.5);
        flex: none;
        background: #141517;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
      }

      .author-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .author-status-dot {
        position: absolute;
        bottom: 1px;
        right: 1px;
        width: 8px;
        height: 8px;
        background: #10B981;
        border-radius: 50%;
        border: 1.5px solid #1a1b1e;
        box-shadow: 0 0 7px rgba(16, 185, 129, 0.85);
      }

      /* ---- Textos ---- */
      .author-text-wrap {
        display: flex;
        flex-direction: column;
        text-align: left;
        gap: 0.1rem;
      }

      .author-tagline {
        font-family: var(--mono);
        font-size: 0.58rem;
        font-weight: 500;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.54);
      }

      .author-name {
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.005em;
        line-height: 1.1;
      }

      .author-arrow-indicator {
        display: flex;
        align-items: center;
        color: rgba(230, 230, 230, 0.55);
        margin-left: 0.15rem;
      }

      .indicator-svg {
        display: block;
        width: 10px;
        height: 10px;
        transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
      }

      .author-floating-widget.is-open .indicator-svg {
        transform: rotate(180deg);
        color: #fff;
      }

      /* ---- Menú Desplegable Social ---- */
      .author-social-dropdown {
        position: absolute;
        bottom: calc(100% + 0.65rem);
        right: 0;
        min-width: 200px;
        background: rgba(22, 23, 26, 0.96);
        border: 1px solid rgba(230, 230, 230, 0.22);
        border-radius: 13px;
        padding: 0.5rem;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
        opacity: 0;
        transform: translateY(10px) scale(0.95);
        pointer-events: none;
        transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        transform-origin: bottom right;
      }

      /* Puente invisible que conecta el botón con el menú para evitar que se cierre el hover */
      .author-social-dropdown::after {
        content: "";
        position: absolute;
        bottom: -1rem;
        left: 0;
        right: 0;
        height: 1.2rem;
        pointer-events: auto;
        background: transparent;
      }

      .author-floating-widget.is-open .author-social-dropdown {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
      }

      .author-dropdown-header {
        padding: 0.3rem 0.55rem 0.38rem;
        border-bottom: 1px solid rgba(230, 230, 230, 0.1);
        margin-bottom: 0.3rem;
      }

      .author-dropdown-title {
        font-family: var(--mono);
        font-size: 0.6rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: rgba(230, 230, 230, 0.5);
        font-weight: 600;
      }

      .author-dropdown-list {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .author-social-item {
        display: flex;
        align-items: center;
        gap: 0.68rem;
        padding: 0.48rem 0.68rem;
        border-radius: 7px;
        text-decoration: none;
        color: rgba(242, 239, 233, 0.88);
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.03em;
        transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
      }

      .author-social-item:hover,
      .author-social-item:focus-visible {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        transform: translateX(2px);
        outline: none;
      }

      .author-social-icon-box {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.07);
        flex: none;
      }

      .author-social-label {
        flex: 1;
        font-weight: 500;
      }

      .author-social-arrow {
        opacity: 0.38;
        transition: opacity 0.15s, transform 0.15s;
        flex: none;
      }

      .author-social-item:hover .author-social-arrow {
        opacity: 0.95;
        transform: translate(1.5px, -1.5px);
      }

      @media (max-width: 820px) {
        .author-floating-widget {
          bottom: 1.1rem;
          right: 1.1rem;
        }
        .author-tagline {
          font-size: 0.54rem;
        }
        .author-avatar-frame {
          width: 34px;
          height: 34px;
        }
        .author-name {
          font-size: 0.8rem;
        }
        .author-trigger-btn {
          padding: 0.3rem 0.75rem 0.3rem 0.3rem;
          gap: 0.6rem;
        }
        .author-social-dropdown {
          min-width: 185px;
        }
      }
    </style>
  </body>
</html>
