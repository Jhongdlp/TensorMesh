---
import GalaxyView from "../components/Galaxy.tsx";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Atlas Vectorial</title>
    <meta
      name="description"
      content="Galaxia navegable de embeddings: 50.000 palabras por idioma, colocadas por simulación de fuerzas sobre su grafo de vecinos más cercanos."
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />

    <!-- Arranque de los 2,1 MB de binarios, antes de que exista React.
         Sin esto la descarga no empieza hasta que la isla hidrata y corre su
         primer efecto: primero el HTML, luego el bundle, luego el fetch. Es el
         único tramo del arranque que no estaba medido y el más fácil de ganar.

         Es un `fetch` y no cuatro `<link rel=preload>` a propósito. Un preload
         `as="fetch"` del mismo origen sólo casa con la petición posterior si
         los modos de CORS y de credenciales coinciden exactamente; cuando no
         casa, el navegador **descarga el archivo dos veces** y el arreglo sale
         al doble de coste que el problema. Guardando la promesa no hay nada que
         casar: `loader.ts` se encuentra la petición ya en marcha.

         El idioma se lee de la URL aquí mismo porque `?lang=en` traería otros
         2,1 MB, y precargar el juego equivocado es peor que no precargar. -->
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search).get("lang");
        var lang = q === "en" || q === "es" ? q : "es";
        var out = {};
        ["meta.json", "positions.bin", "edges.bin", "labels.bin", "attrs.bin"]
          .forEach(function (f) {
            var url = "/data/" + lang + "/" + f;
            // `catch` aquí y no en quien la consume: una promesa rechazada sin
            // manejador en el momento de crearse es un error no capturado en
            // consola aunque `loader.ts` la trate después.
            out[url] = fetch(url).catch(function () { return null; });
          });
        window.__atlas = out;
      })();
    </script>
  </head>
  <body>
    <!-- El visor es la única isla que se hidrata; el resto de la página
         (cuando lleguen las lecciones) será HTML estático. -->
    <GalaxyView client:only="react" lang="es" />

    <noscript>
      <p class="ns">La galaxia necesita JavaScript y WebGL para dibujarse.</p>
    </noscript>

    <style is:global>
      /* El HUD entero es acromático: negro, blancos con alfa y nada más.
         El único color que queda en la interfaz es el punto de zona, porque
         ése no decora — es la misma tinta que la palabra tiene en la malla.
         Todo lo demás compite con la galaxia, que ya es el color de la página. */
      :root {
        --void: #05070d;
        --panel: rgba(0, 0, 0, 0.88);
        --ink: #fff;
        --ink-2: rgba(255, 255, 255, 0.66);
        --ink-3: rgba(255, 255, 255, 0.42);
        --ink-4: rgba(255, 255, 255, 0.28);
        --rule: rgba(255, 255, 255, 0.14);
        /* Fondos de control: blanco tenue sobre el panel, no un azul propio.
           En reposo casi no se ven; encendidos son el mismo blanco, más denso. */
        --btn: rgba(255, 255, 255, 0.05);
        --btn-on: rgba(255, 255, 255, 0.15);
        /* Medidas del cajón. Están aquí y no en cada regla porque tres sitios
           dependen del mismo número: el ancho del cuerpo, cuánto se desplaza
           al plegarse y dónde tiene que quedar la atribución. */
        --side-w: min(14rem, 76vw);
        --tool: 1.7rem;
        --side-pad: 0.55rem;
        /* Lo que queda a la vista plegado: la tira de herramientas y nada más. */
        --tab-w: calc(var(--tool) + var(--side-pad) * 2 + 2px);
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: var(--void);
        color: var(--ink-2);
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .galaxy-root { position: fixed; inset: 0; }

      .galaxy-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        cursor: crosshair;
      }
      .galaxy-canvas.over { cursor: pointer; }

      /* El vacío no es plano: un halo frío detrás de la nube y una viñeta que
         cierra el encuadre y disimula el corte recto del canvas. Capa estática
         encima del canvas — el contexto es `alphaMode: "opaque"`, así que nada
         puesto detrás llegaría a verse. Sin `mix-blend-mode`: source-over es la
         mezcla más barata que hay y el compositor ya iba a hacer esta pasada.
         Sin `z-index` para que el HUD, que va después en el DOM, siga encima. */
      .veil {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(farthest-side at 50% 46%,
            rgba(96, 132, 255, 0.115),
            rgba(66, 86, 205, 0.058) 30%,
            rgba(30, 40, 110, 0.018) 62%,
            rgba(10, 14, 40, 0) 100%),
          radial-gradient(farthest-corner at 50% 50%,
            rgba(0, 0, 0, 0) 30%,
            rgba(1, 2, 7, 0.42) 66%,
            rgba(0, 1, 4, 0.78) 86%,
            rgba(0, 0, 2, 1) 100%);
      }

      /* --- tooltip al pasar el ratón, en lugar de etiquetas permanentes --- */
      .tip {
        position: absolute;
        transform: translate(14px, -50%);
        pointer-events: none;
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 12px;
        color: #fff;
        background: rgba(0, 0, 0, 0.92);
        border: 1px solid var(--rule);
        border-radius: 7px;
        padding: 0.22rem 0.5rem;
        white-space: nowrap;
        z-index: 5;
      }

      /* --- raíl derecho ---
         Los tres paneles de la derecha (mandos, teclas, ficha) son una columna
         flex y no tres cajas con `top`/`bottom` propios. Es lo que deja poner
         la ficha en la esquina de abajo —`margin-top: auto`— con la garantía
         de que nunca pisará a las teclas: si el alto no da, el flex encoge la
         ficha y la lista de vecinos hace scroll dentro. El raíl no recibe
         ratón; sus hijos sí, para poder arrastrar la galaxia entre paneles. */
      .rail {
        position: absolute;
        top: 1rem;
        bottom: 1rem;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.7rem;
        pointer-events: none;
        z-index: 3;
      }
      .rail > * { pointer-events: auto; }
      .rail-r {
        right: 1rem;
        width: min(19rem, calc(100vw - 2rem));
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #ffffff2b transparent;
      }
      /* La ficha a la esquina inferior derecha, que es donde estaba. */
      .rail-r .card { margin-top: auto; max-height: 32rem; }

      /* --- cajón izquierdo ---
         Pegado al borde y a todo el alto: es el mueble de la página, no un
         panel flotante más. Plegar es sólo `width`, y el cuerpo lleva un ancho
         fijo con `overflow: hidden` encima para que al encogerse se **recorte**
         en vez de reflotar el contenido a medio camino. */
      .side {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: var(--side-w);
        display: flex;
        flex-direction: column;
        gap: var(--side-pad);
        padding: var(--side-pad);
        background: var(--panel);
        border-right: 1px solid var(--rule);
        border-radius: 0 16px 16px 0;
        backdrop-filter: blur(12px);
        overflow: hidden;
        z-index: 4;
        transition: width 0.24s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .galaxy-root:not(.side-open) .side { width: var(--tab-w); }

      /* La barra. `flex-wrap` es todo el mecanismo del plegado: a lo ancho del
         cajón los cuatro botones caben en fila; a lo ancho de la tira sólo cabe
         uno por línea y la misma barra se convierte en columna. */
      .tools {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        flex: 0 0 auto;
      }
      .tool {
        width: var(--tool);
        height: var(--tool);
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        background: var(--btn);
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--ink-3);
        cursor: pointer;
        padding: 0;
      }
      .tool:hover { background: rgba(255, 255, 255, 0.1); color: var(--ink); }
      .tool.on { background: var(--btn-on); color: var(--ink); }
      .tool:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

      .side-body {
        flex: 1;
        min-height: 0;
        /* Ancho fijo: si se dejara fluir, al plegar el cajón los botones de
           idioma se aplastarían durante la animación en vez de irse limpios. */
        width: calc(var(--side-w) - var(--side-pad) * 2);
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: #ffffff2b transparent;
        transition: opacity 0.16s ease, visibility 0s linear 0s;
      }
      .galaxy-root:not(.side-open) .side-body {
        opacity: 0;
        visibility: hidden;   /* si no, el tabulador entra en el buscador oculto */
        transition: opacity 0.16s ease, visibility 0s linear 0.24s;
      }

      /* --- paneles del raíl derecho --- */
      .hud {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: 14px;
        backdrop-filter: blur(9px);
        padding: 0.85rem 0.95rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 0 0 auto;
      }

      .langs {
        display: flex;
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
        border-radius: 9px;
        overflow: hidden;
      }
      .langs button {
        flex: 1;
        background: var(--btn);
        border: 0;
        color: var(--ink-3);
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.66rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        padding: 0.42rem 0;
        cursor: pointer;
      }
      .langs button:hover { background: rgba(255, 255, 255, 0.09); color: var(--ink-2); }
      .langs button.on { background: var(--btn-on); color: var(--ink); }

      .hud-tr { width: 100%; gap: 0.35rem; }
      .ctl-head { display: flex; justify-content: space-between; align-items: baseline; }
      .eyebrow {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.62rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--ink-2);
      }
      .fps {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.66rem;
        color: var(--ink-3);
        font-variant-numeric: tabular-nums;
      }

      .ctl {
        display: grid;
        grid-template-columns: 4.6rem 1fr 2.4rem;
        align-items: center;
        gap: 0.4rem;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.65rem;
        color: var(--ink-3);
      }
      .ctl b {
        color: var(--ink-2);
        font-weight: 400;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .ctl input[type="range"] {
        appearance: none;
        width: 100%;
        height: 2px;
        background: var(--rule);
        cursor: pointer;
      }
      .ctl input[type="range"]::-webkit-slider-thumb {
        appearance: none;
        width: 10px; height: 10px;
        background: var(--ink);
        border-radius: 50%;
      }
      .ctl input[type="range"]::-moz-range-thumb {
        width: 10px; height: 10px; border: 0;
        background: var(--ink);
        border-radius: 50%;
      }
      .ctl input:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

      /* --- leyenda de teclado, panel propio bajo los mandos --- */
      .keys {
        padding: 0.6rem 0.7rem;
        gap: 0.3rem;
        width: 100%;
      }
      .keys summary {
        cursor: pointer;
        color: var(--ink-3);
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.6rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        list-style: none;
      }
      .keys summary::-webkit-details-marker { display: none; }
      .keys summary::before { content: "\25BE  "; color: var(--ink-3); }
      .keys:not([open]) summary::before { content: "\25B8  "; }
      .keys summary:hover { color: var(--ink-2); }
      .keys dl {
        margin: 0.45rem 0 0;
        display: grid;
        gap: 0.22rem;
      }
      .keys dl > div {
        display: grid;
        grid-template-columns: 5.2rem 1fr;
        align-items: center;
        gap: 0.55rem;
      }
      .keys dt { display: flex; gap: 0.2rem; }
      .keys dd {
        margin: 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.62rem;
        color: var(--ink-3);
      }
      .keys kbd {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.6rem;
        line-height: 1;
        color: var(--ink-2);
        background: var(--btn);
        border: 1px solid var(--rule);
        border-bottom-width: 2px;
        border-radius: 3px;
        padding: 0.22rem 0.3rem;
        min-width: 1.5rem;
        text-align: center;
      }
      /* Sin teclado que anunciar: en pantallas de mano sólo taparía galaxia. */
      @media (max-width: 720px), (max-height: 620px) {
        .keys { display: none; }
      }

      .cull {
        margin: 0.2rem 0 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.6rem;
        line-height: 1.5;
        color: var(--ink-3);
        font-variant-numeric: tabular-nums;
      }
      .ctl-row {
        display: flex;
        gap: 1px;
        margin-top: 0.35rem;
        background: var(--rule);
        border-radius: 9px;
        overflow: hidden;
      }
      .ctl-row button {
        flex: 1;
        min-width: 0;
        background: var(--btn);
        border: 0;
        color: var(--ink-3);
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.62rem;
        letter-spacing: 0.04em;
        padding: 0.4rem 0.15rem;
        cursor: pointer;
      }
      .ctl-row button:hover { background: rgba(255, 255, 255, 0.09); color: var(--ink-2); }
      .ctl-row button.on { background: var(--btn-on); color: var(--ink); }

      .hint { color: var(--ink-4); }
      .mode { letter-spacing: 0.07em; }
      .mode-live { color: var(--ink-2); }

      .attrib {
        position: absolute;
        left: calc(var(--tab-w) + 1rem);
        bottom: 0.8rem;
        transition: left 0.24s cubic-bezier(0.4, 0, 0.2, 1);
        margin: 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.62rem;
        letter-spacing: 0.05em;
        color: var(--ink-4);
      }
      .side-open .attrib { left: calc(var(--side-w) + 1rem); }
      .attrib a { color: var(--ink-3); }
      .attrib a:hover { color: var(--ink-2); }
      .hud input,
      .side-body input {
        width: 100%;
        background: var(--btn);
        border: 1px solid var(--rule);
        color: var(--ink);
        font: inherit;
        font-size: 0.9rem;
        padding: 0.45rem 0.7rem;
        border-radius: 9px;
      }
      .hud input:focus-visible,
      .side-body input:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }

      .stat, .err, .foot {
        margin: 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.68rem;
        line-height: 1.5;
        letter-spacing: 0.03em;
        color: var(--ink-3);
      }
      /* Sin rojo que gastar: el error se marca con un filete y tinta plena,
         que es como lo marcaría una página impresa. */
      .err {
        color: var(--ink);
        border-left: 2px solid var(--ink-3);
        padding-left: 0.5rem;
      }

      /* Punto de zona: el mismo color que la palabra tiene en la malla. Es la
         única leyenda que hay, y por eso va pegada al dato, no en un recuadro
         aparte que nadie mira. */
      .swatch {
        display: inline-block;
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        margin-right: 0.45rem;
        vertical-align: 0.02rem;
        box-shadow: 0 0 0 1px #0006 inset;
      }
      /* ================= la ficha =================
         Negro y blanco, y a propósito. El resto del HUD es instrumental
         —mandos, cifras, estado— y puede permitirse el acento frío; la ficha
         es lectura, y ahí cualquier tinta compite con la única que significa
         algo: el punto de zona. Sin reglas entre filas ni cajas dentro de
         cajas: la jerarquía la llevan el tamaño y el aire, que es lo que hace
         una página editorial. */
      .card {
        display: flex;
        flex-direction: column;
        /* `min-height: 0` es lo que deja encoger al hijo flex: sin él la lista
           de vecinos empuja la ficha fuera de pantalla en vez de hacer scroll. */
        min-height: 0;
        flex: 0 1 auto;
        background: rgba(0, 0, 0, 0.9);
        border: 1px solid #ffffff24;
        border-radius: 18px;
        backdrop-filter: blur(12px);
        padding: 1.05rem 1.15rem 0.9rem;
        color: #fff;
        animation: card-in 0.18s ease-out;
      }
      @keyframes card-in {
        from { opacity: 0; transform: translateY(6px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .card { animation: none; }
      }

      .card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.6rem;
      }
      .kicker {
        margin: 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.6rem;
        line-height: 1.6;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #ffffff73;
      }
      .kicker.rule {
        margin-top: 0.95rem;
        padding-top: 0.7rem;
        border-top: 1px solid #ffffff1f;
        color: #ffffff59;
      }
      .card-title {
        margin: 0.4rem 0 0;
        font-size: 1.6rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.08;
        color: #fff;
        overflow-wrap: anywhere;
      }
      .card-x {
        flex: 0 0 auto;
        width: 1.65rem;
        height: 1.65rem;
        margin: -0.15rem -0.25rem 0 0;
        display: grid;
        place-items: center;
        background: none;
        border: 1px solid #ffffff1f;
        border-radius: 50%;
        color: #ffffff8c;
        font-size: 0.95rem;
        line-height: 1;
        cursor: pointer;
      }
      .card-x:hover { background: #ffffff14; border-color: #ffffff3d; color: #fff; }
      .card-x:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

      .nbrs {
        list-style: none;
        margin: 0.4rem 0 0;
        padding: 0;
        min-height: 0;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #ffffff2b transparent;
      }
      .nbrs button {
        width: 100%;
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        text-align: left;
        background: none;
        border: 0;
        border-radius: 10px;
        color: #fff;
        font: inherit;
        font-size: 0.92rem;
        padding: 0.34rem 0.5rem;
        margin-left: -0.5rem;
        cursor: pointer;
      }
      .nbrs .w { flex: 1; overflow-wrap: anywhere; }
      .nbrs .s {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.68rem;
        color: #ffffff59;
        font-variant-numeric: tabular-nums;
      }
      .nbrs .swatch { align-self: center; margin-right: 0; }
      .nbrs button:hover { background: #ffffff12; }
      .nbrs button:hover .s { color: #ffffffa6; }
      .nbrs button:focus-visible { outline: 1px solid #ffffff59; outline-offset: -1px; }

      /* ================= sugerencias del buscador =================
         Flotan sobre la galaxia en vez de empujar el panel: escribir no puede
         reorganizar el cajón bajo el cursor. Y por eso `.find` es el contexto
         de posición — la lista se cuelga del formulario, no del panel, así que
         el mismo componente sirve en el cajón y dentro de la ficha. */
      .find { position: relative; }
      .find-s input { font-size: 0.82rem; padding: 0.35rem 0.55rem; }

      .sugg {
        position: absolute;
        top: calc(100% + 0.3rem);
        left: 0;
        right: 0;
        z-index: 6;
        list-style: none;
        margin: 0;
        padding: 0.25rem;
        max-height: 14rem;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #ffffff2b transparent;
        background: rgba(0, 0, 0, 0.94);
        border: 1px solid #ffffff24;
        border-radius: 12px;
        backdrop-filter: blur(12px);
      }
      .sugg button {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-align: left;
        background: none;
        border: 0;
        border-radius: 8px;
        color: #fff;
        font: inherit;
        font-size: 0.88rem;
        padding: 0.3rem 0.45rem;
        cursor: pointer;
      }
      .sugg .w { flex: 1; overflow-wrap: anywhere; }
      /* El rango de frecuencia: es lo que distingue la palabra que se busca de
         su plural raro cuando las dos empiezan igual. */
      .sugg .s {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.62rem;
        color: #ffffff4d;
        font-variant-numeric: tabular-nums;
      }
      .sugg .swatch { margin-right: 0; flex: none; }
      .sugg button.on { background: #ffffff1f; }
      .sugg button.on .s { color: #ffffffa6; }

      /* ================= el camino =================
         Una cadena, no una lista: el filete vertical entre filas es lo que
         dice que cada palabra viene de la anterior. La lista de vecinos, que
         no tiene orden, no lo lleva a propósito. */
      .road {
        list-style: none;
        margin: 0.5rem 0 0;
        padding: 0;
      }
      .road li { position: relative; }
      .road li + li::before {
        content: "";
        position: absolute;
        left: 0.2rem;
        top: -0.45rem;
        height: 0.45rem;
        border-left: 1px solid #ffffff3d;
      }
      .road button {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        text-align: left;
        background: none;
        border: 0;
        border-radius: 10px;
        color: #fff;
        font: inherit;
        font-size: 0.9rem;
        padding: 0.24rem 0.5rem;
        margin-left: -0.5rem;
        cursor: pointer;
      }
      .road .w { flex: 1; overflow-wrap: anywhere; }
      .road .s {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.66rem;
        color: #ffffff59;
        font-variant-numeric: tabular-nums;
      }
      .road button:hover { background: #ffffff12; }
      .road button:focus-visible { outline: 1px solid #ffffff59; outline-offset: -1px; }

      /* Botón que se lee como enlace: va dentro de una frase, y una caja ahí
         partiría la línea en dos cosas. */
      .link {
        background: none;
        border: 0;
        padding: 0;
        font: inherit;
        color: var(--ink-2);
        text-decoration: underline;
        text-underline-offset: 2px;
        cursor: pointer;
      }
      .link:hover { color: #fff; }

      /* ================= mando virtual (modo vuelo) =================
         Estaba escrito con veinte líneas de `element.style` en cada uno de los
         dos motores. El aspecto vive aquí, con el resto del tema; la mecánica,
         en `galaxy/joystick.ts`. El tamaño tiene que cuadrar con `JOY_MAX`. */
      .joy {
        position: absolute;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 1px solid #ffffff3d;
        background: #00000059;
        backdrop-filter: blur(3px);
        pointer-events: none;
        z-index: 4;
      }
      .joy-knob {
        position: absolute;
        left: 25px;
        top: 25px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #ffffff8c;
        transition: transform 0.05s linear;
      }

      .card .foot {
        margin-top: 0.8rem;
        padding-top: 0.6rem;
        border-top: 1px solid #ffffff1f;
        font-size: 0.6rem;
        letter-spacing: 0.05em;
        color: #ffffff59;
      }

      .ns { position: absolute; top: 45%; width: 100%; text-align: center; }
    </style>
  </body>
</html>
