---
return Astro.redirect("/gradient-descent", 301);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/gradient-descent" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" href="/icons/ChatGPT Image 23 ago 2026, 10_28_10.png" />
    <link rel="canonical" href="/gradient-descent" />
    <title>Redirecting to Gradient Descent...</title>
    <script is:inline>
      window.location.replace("/gradient-descent" + window.location.search);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/gradient-descent">Gradient Descent</a>...</p>
  </body>
</html>
    <meta
      name="description"
      content="Descenso de gradiente dibujado como campo: miles de caminantes soltados a la vez sobre cinco superficies clásicas."
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
    />
  </head>
  <body>
    <Descent client:only="react" />

    <style is:global>
      /* --------------------------------------------------- sin WebGPU
         Ocupa la pantalla entera: sin el paso de cómputo no hay sala, así que
         no hay nada detrás que dejar ver. */
      .room-nogpu {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.9rem;
        text-align: center;
        padding: 2rem;
        background: var(--void);
        z-index: 5;
      }
      .room-nogpu p {
        margin: 0;
        max-width: 30rem;
        color: var(--ink-2);
        font-size: 0.92rem;
        line-height: 1.6;
      }
      .room-nogpu-title {
        font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
        font-size: 1.5rem !important;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ink) !important;
      }
      .room-nogpu code,
      .room-descent code {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.9em;
        color: var(--ink);
      }

      /* ------------------------------------------------ barra de progreso
         La corrida son 6.000 pasos y un contador suelto no lo dice. La barra
         además enseña los dos tiempos de estas funciones sin escribirlos: se
         llena despacio los primeros cuarenta pasos —van de uno en uno para que
         el primer acto se vea— y de golpe a partir de ahí. */
      .room-descent .bar {
        height: 3px;
        background: var(--rule);
        border-radius: 2px;
        overflow: hidden;
      }
      .room-descent .bar i {
        display: block;
        height: 100%;
        background: var(--ink);
        transition: width 0.25s linear;
      }
      @media (prefers-reduced-motion: reduce) {
        .room-descent .bar i { transition: none; }
      }

      /* ----------------------------------------------------------- la ficha */
      .room-descent .formula {
        margin: 0.5rem 0 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        line-height: 1.5;
        letter-spacing: 0.01em;
        color: var(--ink-3);
        overflow-wrap: anywhere;
      }
      .room-descent .note {
        margin: 0.7rem 0 0;
        font-size: 0.8rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.78);
      }
      .room-descent .note b { color: #fff; font-weight: 600; }
      .room-descent .phase { margin-top: 1rem; color: var(--ink-4); }
      /* La ficha tiene tope de alto y su cuerpo hace scroll: con las notas
         desplegadas, Beale escribe media pantalla y sin tope empuja el HUD
         fuera del raíl. */
      .room-descent .rail-r .card { margin-top: auto; max-height: 62vh; }

      /* ---------------------------------------------------------- la leyenda
         Cada renglón lleva su muestra pegada al texto que la explica. Una
         leyenda con las muestras en una columna y los nombres en otra obliga a
         hacer la correspondencia con el dedo. */
      .room-descent .key-line {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin: 0;
        font-size: 0.72rem;
        line-height: 1.5;
        color: var(--ink-3);
      }
      .room-descent .key-line b { color: var(--ink-2); font-weight: 600; }
      .room-descent .ramp {
        flex: 0 0 auto;
        width: 1.5rem;
        height: 0.62rem;
        margin-top: 0.22rem;
        border-radius: 2px;
        box-shadow: 0 0 0 1px #0006 inset;
      }
      /* Los mismos cinco anclajes que `lossRamp` en `surface.wgsl`. */
      .room-descent .ramp-loss {
        background: linear-gradient(90deg,
          #0d1440, #33256e, #7a2f76, #c25a3c, #f2c46b);
      }
      /* Las curvas: escalones iguales, apretándose. */
      .room-descent .ramp-hist {
        background:
          repeating-linear-gradient(90deg,
            rgba(255, 226, 200, 0.85) 0 1px, transparent 1px 4px),
          linear-gradient(90deg, #7a2f76, #c25a3c);
      }
      /* Los mismos cuatro anclajes que `heatRamp` en `render.wgsl`. */
      .room-descent .ramp-heat {
        background: linear-gradient(90deg, #9efffa, #73dbff, #ffc75c, #ff4d29);
      }
      /* `ramp-origin` recibe su fondo desde el JSX, calculado con `rampCss`:
         la copia escrita a mano se desincroniza en cuanto se toque la paleta. */
      .room-descent .ramp-target {
        background:
          radial-gradient(circle at 50% 50%,
            transparent 0 22%, rgba(217, 235, 255, 0.95) 22% 38%,
            transparent 38% 62%, rgba(217, 235, 255, 0.6) 62% 76%, transparent 76%),
          #241a2e;
      }

      /* Un botón de la tira que no aplica ahora mismo —«un paso» mientras
         corre— se apaga en vez de desaparecer: un mueble al que le cambia el
         número de botones hace que los demás salten de sitio. */
      .room-descent .tool:disabled {
        opacity: 0.3;
        cursor: default;
      }
      .room-descent .tool:disabled:hover {
        background: var(--btn);
        color: var(--ink-3);
      }

      /* En pantallas bajas la ficha se lleva el raíl entero; el HUD, que es la
         lectura en vivo, no puede quedarse sin sitio. */
      @media (max-height: 640px) {
        .room-descent .rail-r .card { max-height: 46vh; }
      }
    </style>
  </body>
</html>
