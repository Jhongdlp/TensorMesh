---
// Sala 03 — Mapas Autoorganizados de Kohonen.
//
// Página aparte y no un modo dentro de `index.astro` para evitar la descarga
// de binarios masivos de embeddings innecesariamente y separar las islas de React.
import Som from "../rooms/som/Som.tsx";
import "../styles/shell.css";
import Seo from "../components/Seo.astro";
import SeoBody from "../components/SeoBody.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo path="/self-organizing-maps" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
    />
  </head>
  <body>
    <SeoBody path="/self-organizing-maps" />
    <Som client:only="react" />

    <style is:global>
      /* --------------------------------------------------- sin WebGPU */
      .room-nogpu {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.9rem;
        text-align: center;
        padding: 2rem;
        background: var(--void);
        z-index: 5;
      }
      .room-nogpu p {
        margin: 0;
        max-width: 30rem;
        color: var(--ink-2);
        font-size: 0.92rem;
        line-height: 1.6;
      }
      .room-nogpu-title {
        font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
        font-size: 1.5rem !important;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ink) !important;
      }
      .room-nogpu code,
      .room-descent code {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.9em;
        color: var(--ink);
      }

      /* ------------------------------------------------ barra de progreso */
      .room-descent .bar {
        height: 3px;
        background: var(--rule);
        border-radius: 2px;
        overflow: hidden;
      }
      .room-descent .bar i {
        display: block;
        height: 100%;
        background: var(--ink);
        transition: width 0.25s linear;
      }
      @media (prefers-reduced-motion: reduce) {
        .room-descent .bar i { transition: none; }
      }

      /* ----------------------------------------------------------- la ficha */
      .room-descent .formula {
        margin: 0.5rem 0 0;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        line-height: 1.5;
        letter-spacing: 0.01em;
        color: var(--ink-3);
        overflow-wrap: anywhere;
      }
      .room-descent .note {
        margin: 0.7rem 0 0;
        font-size: 0.8rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.78);
      }
      .room-descent .note b { color: #fff; font-weight: 600; }
      .room-descent .phase { margin-top: 1rem; color: var(--ink-4); }
      .room-descent .rail-r .card { margin-top: auto; max-height: 62vh; }

      /* ---------------------------------------------------------- la leyenda */
      .room-descent .key-line {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin: 0;
        font-size: 0.72rem;
        line-height: 1.5;
        color: var(--ink-3);
      }
      .room-descent .key-line b { color: var(--ink-2); font-weight: 600; }
      .room-descent .ramp {
        flex: 0 0 auto;
        width: 1.5rem;
        height: 0.62rem;
        margin-top: 0.22rem;
        border-radius: 2px;
        box-shadow: 0 0 0 1px #0006 inset;
      }
      .room-descent .ramp-loss {
        background: linear-gradient(90deg, #1266f2, #24b0f0, #f2c420, #ff3818);
      }
      .room-descent .ramp-heat {
        background: linear-gradient(90deg, #ff4070, #00f0ff, #f0ff00);
      }
      .room-descent .ramp-target {
        background:
          radial-gradient(circle at 50% 50%,
            transparent 0 22%, rgba(217, 235, 255, 0.95) 22% 38%,
            transparent 38% 62%, rgba(217, 235, 255, 0.6) 62% 76%, transparent 76%),
          #241a2e;
      }

      .room-descent .tool:disabled {
        opacity: 0.3;
        cursor: default;
      }
      .room-descent .tool:disabled:hover {
        background: var(--btn);
        color: var(--ink-3);
      }
    </style>
  </body>
</html>
